# Required for live PrizePicks / DFS / sportsbook market data
ODDS_API_KEY=

# Optional: live esports schedules; historical player stats require an eligible PandaScore plan
PANDASCORE_TOKEN=

# Live engine controls
DFS_MAX_EVENTS_PER_SPORT=14
DFS_REQUEST_CONCURRENCY=5
DFS_CACHE_TTL_SECONDS=120
DFS_MIN_SPORTSBOOK_SOURCES=2

# Keep this at 10 or fewer to stay within one bookmaker-region equivalent per market request.
DFS_BOOKMAKERS=prizepicks,underdog,dabble_us_dfs,pick6,pinnacle,fanduel,draftkings,caesars,betmgm,betrivers
